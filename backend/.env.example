NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=postgresql://az_hotel:az_hotel_dev@localhost:5432/az_hotel

# Auth
JWT_SECRET=replace-with-a-32-byte-secret
JWT_EXPIRES_IN=7d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# CORS allow-list (comma-separated)
FRONTEND_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001

# Mail (optional)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AZ Hôtel des Arts <reservations@azhoteldesarts.com>"

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8
